// Workers 部署配置（Pages Functions 不可用时的替代路径）。
// 用法: wrangler deploy -c wrangler-workers.jsonc
// 静态资产直接由 Workers Static Assets 提供；/api/* 与 /assets/* 先进入 Worker。
{
  "name": "stackhk13",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/assets/*"]
  },
  "kv_namespaces": [
    { "binding": "STACKHK", "id": "ed9ee39834274da286d7f06aaaa7e5f9" }
  ],
  "vars": {
    "ADMIN_USERNAME": "Stackhk007",
    "SITE_VERSION": "1.0.0"
  }
}
